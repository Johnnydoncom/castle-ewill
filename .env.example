# ─────────────────────────────────────────────────────────────────────────────
# Castle eWill & Trust — environment configuration
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Any MySQL 8+ instance: local, Railway, PlanetScale, Aiven, RDS.
DATABASE_URL=mysql://castle:castle@127.0.0.1:3306/castle_ewill
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 32
AUTH_SECRET=
# Encrypts every document held in the vault. Losing this key makes stored
# documents unrecoverable — back it up somewhere safe before going live.
ENCRYPTION_KEY=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank in development and messages are printed to the console
# instead of being sent. It is required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Castle eWill & Trust <ewillcastle@gmail.com>"
MAIL_REPLY_TO=ewillcastle@gmail.com

# ── Document storage ────────────────────────────────────────────────────────
# local  — filesystem, for development and single-node hosts
# s3     — Cloudflare R2 / AWS S3 / MinIO (recommended for production)
# gdrive — Google Drive service account (folder must live on a Shared Drive)
#
# Documents are AES-256-GCM encrypted by the application before upload, so the
# provider only ever holds ciphertext.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage

# S3 / Cloudflare R2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Google Drive service account
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=
GDRIVE_FOLDER_ID=

# ── Payments (phase 2) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" you set in the Flutterwave dashboard. Flutterwave echoes it
# in the verif-hash header instead of signing the payload; without it, webhooks
# are refused rather than trusted.
FLUTTERWAVE_SECRET_HASH=

# ── Identity verification ───────────────────────────────────────────────────
# manual_review — the capture is stored for an administrator to compare against
#                 the uploaded ID. Works with no vendor account.
# dojah         — automated liveness detection and ID face matching.
#
# Browser-side liveness is a first filter, not anti-spoofing: a client can skip
# the JavaScript entirely. Use an automated provider in production.
VERIFICATION_PROVIDER=manual_review
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# ── SMS (Termii) ────────────────────────────────────────────────────────────
# Leave TERMII_API_KEY blank in development and codes are printed to the
# console. It is required in production.
TERMII_API_KEY=
TERMII_SENDER_ID=Castle

# ── Seeding ─────────────────────────────────────────────────────────────────
# Optional. When both are set, `npm run db:seed` creates a verified admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
