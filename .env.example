# ─────────────────────────────────────────────────────────────────────────────
# Castle eWill & Trust — FRONTEND environment
# Copy to .env.local and fill in. Never commit it.
#
# This is a frontend. Since the migration to the Laravel API it holds no
# database credentials, no encryption key, no SMTP account, no payment secrets
# and no KYC keys — all of those live in ../backend/.env, where they belong.
#
# If you find yourself adding a secret here, that is a strong sign the work
# belongs in the backend instead.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Public origin of this application. Used for absolute links and for the
# same-origin check on mutating routes.
APP_URL=http://localhost:3000

# ── Backend API ─────────────────────────────────────────────────────────────
# Where the Laravel API lives, including the version prefix. Versioned in the
# URL so a backend deploy that adds /api/v2 does not disturb this frontend
# until it is pointed at it deliberately.
#
# API_URL is used server-side, by lib/api/client.ts, which forwards the
# browser's Sanctum session cookie for SSR reads. Point it at an internal
# address in production if the two run on the same network — traffic that
# never leaves the host cannot be intercepted on the way.
API_URL=http://localhost:8000/api/v1

# The same API, as the *browser* must address it. This one is inlined into the
# client bundle, so it must be publicly reachable and must never carry a
# credential. The browser calls this directly for every mutation
# (lib/api/browser.ts) — sign in, the wizard, uploads, checkout — as well as
# for direct links (vault downloads, generated PDFs). Authenticated by
# Sanctum's own httpOnly session cookie, never by a token this app holds.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
